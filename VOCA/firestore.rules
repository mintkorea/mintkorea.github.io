rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone signed in (including anonymous auth) who knows the sync code
    // (the document id) can read/write it. This is "security by obscurity"
    // via a long random code — fine for a personal/family vocab app, not
    // for anything sensitive.
    match /syncs/{code} {
      allow read, write: if request.auth != null;
    }
  }
}
